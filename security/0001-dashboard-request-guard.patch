+# ── request guard ──
+# The dashboard reads Claude Code transcripts and writes builder templates, so it answers only
+# requests addressed to it. Without these checks any web page open in the same browser can POST to
+# /save (CSRF: a cross-site form or fetch reaches 127.0.0.1 with the user's own network position),
+# and a page on a DNS-rebinding domain can read /runs and /data.json (the request reaches 127.0.0.1
+# carrying the attacker's host name in Host). Three checks close that:
+#   - every request: the Host header must be on the allowlist (loopback names on the bound port,
+#     plus anything in --allowed-host / $WORKFLOW_STUDIO_ALLOWED_HOSTS, e.g. a reverse-proxy domain);
+#   - every POST: an Origin, when present, must be on the same allowlist, and Sec-Fetch-Site must
+#     not be cross-site (browsers always send Origin on POST; curl and the MCP server send none);
+#   - every POST: Content-Type must be application/json, which a plain HTML form cannot send and
+#     which forces a CORS preflight that this server never answers.
+LOOPBACK_NAMES = ("127.0.0.1", "localhost", "[::1]")
+
+
+def _split_host(value):
+    """'name:port' → (name, port), keeping a bracketed IPv6 literal whole."""
+    v = (value or "").strip().lower()
+    if v.startswith("["):
+        end = v.find("]")
+        if end == -1:
+            return v, ""
+        return v[:end + 1], v[end + 2:]
+    name, _, port = v.partition(":")
+    return name, port
+
+
+def host_allowlist(bind_host, port, extra=""):
+    """Host values this server answers: the loopback names (and the bind address, unless it is a
+    wildcard) on the bound port, plus comma-separated extras. An extra without a port allows that
+    name on any port, which is what a reverse proxy on 80/443 needs."""
+    names = set(LOOPBACK_NAMES)
+    if bind_host and bind_host not in ("0.0.0.0", "::"):
+        names.add("[%s]" % bind_host if ":" in bind_host and not bind_host.startswith("[") else bind_host.lower())
+    allowed = {"%s:%d" % (n, port) for n in names}
+    if port == 80:
+        allowed |= names
+    for item in (extra or "").split(","):
+        item = item.strip().lower()
+        if item:
+            allowed.add(item)
+    return frozenset(allowed)
+
+
+def host_allowed(value, allowed):
+    v = (value or "").strip().lower()
+    if not v:
+        return False
+    if v in allowed:
+        return True
+    name, _port = _split_host(v)
+    return name in allowed
+
+
+def origin_allowed(origin, allowed):
+    if origin is None:
+        return True                       # not a browser: CSRF needs a browser
+    parts = urllib.parse.urlsplit(origin.strip())
+    if parts.scheme not in ("http", "https") or not parts.netloc:
+        return False                      # includes the opaque "null" origin
+    return host_allowed(parts.netloc, allowed)
+
+
