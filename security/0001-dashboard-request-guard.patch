+    def _guard(self, write=False):
+        """True when the request may proceed; otherwise answers 403/415 and returns False."""
+        if not host_allowed(self.headers.get("Host"), self.allowed_hosts):
+            self.send_error(403, "Unknown Host",
+                            "This server answers only the hosts on its allowlist. Behind a reverse "
+                            "proxy, add the public host name with --allowed-host or "
+                            "WORKFLOW_STUDIO_ALLOWED_HOSTS.")
+            return False
+        if not write:
+            return True
+        if (self.headers.get("Sec-Fetch-Site") or "").strip().lower() == "cross-site" \
+                or not origin_allowed(self.headers.get("Origin"), self.allowed_hosts):
+            self.send_error(403, "Cross-origin request refused")
+            return False
+        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
+        if ctype != "application/json":
+            self.send_error(415, "Send application/json")
+            return False
+        return True
 
